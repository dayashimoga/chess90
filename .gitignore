# Git ignore rules for ChessMaster monorepo
.dart_tool/
.packages
build/
.pub-cache/
.pub/
*.lock
*.log
.DS_Store
Thumbs.db

# Flutter / Dart
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Test and Coverage
coverage/*
!coverage/coverage_summary.json
!coverage/coverage.html
packages/*/coverage/
apps/*/coverage/
*.lcov
test-results/

# Acceptance Artifacts generated in test
acceptance_tmp/
dist/

# Release Binaries
ChessMaster-Portable.exe
ChessMaster-Windows-x64.zip
ChessMaster-Setup.exe
ChessMaster.apk
ChessMaster.aab

# Local databases
*.db
*.db-journal

# IDE
.idea/
.vscode/
*.iml
*.suo
*.user
