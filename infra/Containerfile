# Disposable development container for ChessMaster platform
FROM dart:stable AS build

# Install Python, FFmpeg, Stockfish and build utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    unzip \
    xz-utils \
    python3 \
    ffmpeg \
    stockfish \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/games/stockfish /usr/local/bin/stockfish

# Install Flutter stable (shallow clone for rapid container build & zero disk bloat)
ENV FLUTTER_HOME="/opt/flutter"
ENV PATH="$FLUTTER_HOME/bin:/usr/games:$PATH"

RUN git config --global --add safe.directory '*' \
    && git clone --depth 1 -b stable https://github.com/flutter/flutter.git $FLUTTER_HOME \
    && flutter config --no-analytics \
    && flutter precache --web

WORKDIR /workspace

# Copy monorepo
COPY . .

# Run test verification
CMD ["bash", "scripts/test.sh"]

